# DEV/TEST ONLY — REQUIRES ACADEMY APPROVAL. Never use these values in production.
ENV_FILE=.env.test.example
NODE_ENV=test
LOG_LEVEL=info
APP_TIMEZONE=Asia/Tashkent
DEFAULT_LOCALE=uz-Latn
SUPPORTED_LOCALES=uz-Latn,ru,en

APP_BASE_URL=http://api:3001
ADMIN_BASE_URL=http://admin-web:3000
BOT_BASE_URL=http://bot:3002
BOT_API_BASE_URL=http://telegram-stub:8081

TELEGRAM_BOT_TOKEN=123456:test-only-token
TELEGRAM_WEBHOOK_SECRET=test-only-webhook-secret-32-characters
PUBLIC_BOT_USERNAME=hmqa_test_only_bot

POSTGRES_DB=hmqa_test
POSTGRES_USER=hmqa_test
POSTGRES_PASSWORD=test-only-postgres-password
DATABASE_URL=postgresql://hmqa_test:test-only-postgres-password@postgres:5432/hmqa_test?schema=public
REDIS_URL=redis://redis:6379/15

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=hmqa-test-private
S3_QUARANTINE_BUCKET=hmqa-test-quarantine
S3_ACCESS_KEY=hmqa-test-access
S3_SECRET_KEY=test-only-minio-secret-key
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=60

SERVICE_AUTH_SECRET=test-only-service-secret-32-characters
SESSION_SECRET=test-only-session-secret-32-characters
ENCRYPTION_KEY=test-only-encryption-key-32-characters

CLAMAV_HOST=clamav
CLAMAV_PORT=3310
FILE_MAX_BYTES=19922944
FILE_QUARANTINE_DIR=/var/lib/hmqa/quarantine
FILE_SCAN_TIMEOUT_MS=120000
RECEIPT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
LIBREOFFICE_PATH=soffice
PREFLIGHT_RENDER_TIMEOUT_MS=60000

LOCAL_AUTH_PRODUCTION_ENABLED=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
SEED_ADMIN_EMAIL=admin-test@example.invalid
SEED_ADMIN_PASSWORD=Test-only-admin-password-2026!
SEED_STAFF_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SENTRY_DSN=
METRICS_TOKEN=test-only-metrics-token-32-characters
RETENTION_DRAFT_DAYS=30
RETENTION_ENABLED=false
PRIVACY_REQUEST_DUE_DAYS=30

API_INTERNAL_URL=http://api:3001
HTTP_PORT=18080

RESTIC_REPOSITORY=s3:https://backup.example.invalid/hmqa-test-restic
RESTIC_PASSWORD=test-only-restic-password-32-characters
BACKUP_S3_ACCESS_KEY=test-only-backup-access
BACKUP_S3_SECRET_KEY=test-only-backup-secret
RESTIC_KEEP_DAILY=2
RESTIC_KEEP_WEEKLY=1
RESTIC_KEEP_MONTHLY=1
