{
  "name": "hmqa-jurnal-bot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm -r --parallel --if-present dev",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:required": "node scripts/run-runtime-suite.mjs integration",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:required": "node scripts/run-runtime-suite.mjs e2e",
    "test:runtime": "vitest run --config vitest.runtime.config.ts",
    "test:runtime:required": "node scripts/run-runtime-suite.mjs runtime",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:i18n": "vitest run packages/i18n/src/i18n.spec.ts",
    "db:generate": "pnpm --filter @hmqa/database prisma:generate",
    "db:migrate": "pnpm --filter @hmqa/database prisma:migrate:deploy",
    "db:migrate:upgrade-test": "pnpm --filter @hmqa/database prisma:migrate:upgrade-test",
    "db:migrate:dev": "pnpm --filter @hmqa/database prisma:migrate:dev",
    "db:seed": "pnpm --filter @hmqa/database prisma:seed",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f --tail=200",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "security:public": "node scripts/public-repo-audit.mjs",
    "compose:validate": "node scripts/validate-compose.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hmqa/config": "workspace:*",
    "@hmqa/database": "workspace:*",
    "@hmqa/i18n": "workspace:*",
    "@hmqa/security": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "ioredis": "^5.7.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.0",
    "yaml": "2.9.0"
  }
}
