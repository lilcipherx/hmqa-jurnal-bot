# Runtime
NODE_ENV=development
LOG_LEVEL=info
APP_TIMEZONE=Asia/Tashkent
DEFAULT_LOCALE=uz-Latn
SUPPORTED_LOCALES=uz-Latn,ru,en

# Public endpoints
APP_BASE_URL=http://localhost:3001
ADMIN_BASE_URL=http://localhost:3000
BOT_BASE_URL=http://localhost:3002

# Telegram - supply real values only through the environment or secret manager
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BOT_USERNAME=replace-with-bot-username
BOT_API_BASE_URL=https://api.telegram.org

# PostgreSQL
POSTGRES_DB=hmqa
POSTGRES_USER=hmqa
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://hmqa:replace-with-local-password@postgres:5432/hmqa?schema=public

# Redis and queues
REDIS_URL=redis://redis:6379/0

# Private S3-compatible object storage
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=hmqa-private
S3_QUARANTINE_BUCKET=hmqa-quarantine
S3_ACCESS_KEY=hmqa-local
S3_SECRET_KEY=replace-with-local-secret
# MinIO-only KMS bootstrap: <key-name>:<base64-encoded-random-32-byte-key>
MINIO_KMS_SECRET_KEY=replace-with-key-name:replace-with-base64-256-bit-key
S3_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=300

# Service and staff-session security
SERVICE_AUTH_SECRET=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# File security
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
FILE_MAX_BYTES=19922944
FILE_QUARANTINE_DIR=/var/lib/hmqa/quarantine
FILE_SCAN_TIMEOUT_MS=120000
RECEIPT_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
LIBREOFFICE_PATH=soffice
PREFLIGHT_RENDER_TIMEOUT_MS=60000

# Staff authentication policy
LOCAL_AUTH_PRODUCTION_ENABLED=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Initial development seed; ignored in production
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=ChangeMe-Only-For-Local-Development-123!
SEED_STAFF_TOTP_SECRET=replace-with-development-base32-secret

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
SENTRY_DSN=
METRICS_TOKEN=replace-with-monitoring-token

# Retention is disabled until approved policy values are supplied
RETENTION_DRAFT_DAYS=30
RETENTION_ENABLED=false
PRIVACY_REQUEST_DUE_DAYS=30

# Admin server-to-server route (inside Docker)
API_INTERNAL_URL=http://api:3001
HTTP_PORT=8080

# Encrypted off-host restic repository (required only for backup profile)
RESTIC_REPOSITORY=s3:https://backup.example.invalid/hmqa-restic
RESTIC_PASSWORD=replace-with-at-least-32-random-characters
BACKUP_S3_ACCESS_KEY=replace-with-backup-access-key
BACKUP_S3_SECRET_KEY=replace-with-backup-secret-key
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
